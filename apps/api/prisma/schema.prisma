generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Staff auth (Nest-owned sessions) ────────────────────────

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  phone         String?
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  lastLoginAt   DateTime?

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]           @relation("AuditActor")
  surveysCreated          Survey[]             @relation("SurveyCreatedBy")
  surveysUpdated          Survey[]             @relation("SurveyUpdatedBy")
  importJobs              ImportJob[]
  exportJobs              ExportJob[]
  paymentsCollected       Payment[]            @relation("PaymentCollectedBy")
  attachmentsUploaded     SurveyAttachment[]
  demandsPublished        AssessmentDemand[]   @relation("DemandPublishedBy")
  demandsVerified         AssessmentDemand[]   @relation("DemandVerifiedBy")
  noticeIssues            DemandNoticeIssue[]  @relation("NoticeGeneratedBy")
  allocationsCreated      PaymentAllocation[]  @relation("AllocationCreatedBy")
  adjustmentsCreated      DemandAdjustment[]   @relation("AdjustmentCreatedBy")
  rebatePoliciesApproved  RebatePolicy[]       @relation("RebatePolicyApprovedBy")
  penaltyPoliciesApproved PenaltyPolicy[]      @relation("PenaltyPolicyApprovedBy")

  @@map("user")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Session {
  id           String    @id @default(cuid())
  expiresAt    DateTime
  tokenHash    String    @unique
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("session")
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  failedAttempts Int       @default(0)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── RBAC ──────────────────────────────────────────────────────

model Role {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permission")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// ─── Ward ──────────────────────────────────────────────────────

model Ward {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  number    Int      @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  surveys    Survey[]
  payments   Payment[]
  taxConfigs TaxConfig[]
  demands    AssessmentDemand[]

  @@map("ward")
}

// ─── Survey ────────────────────────────────────────────────────

enum SurveyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED
}

enum DataQualityStatus {
  COMPLETE
  NEEDS_REVIEW
  INVALID
  DUPLICATE
  MISSING_CONTACT
  MISSING_PROPERTY_NUMBER
  MISSING_MEASUREMENT
}

model Survey {
  id                String            @id @default(cuid())
  surveyId          String            @unique
  status            SurveyStatus      @default(ACTIVE)
  dataQualityStatus DataQualityStatus @default(NEEDS_REVIEW)

  surveyedAt DateTime?
  wardId     String
  ward       Ward      @relation(fields: [wardId], references: [id])

  ownerName       String?
  ownerFatherName String?
  mobile          String?
  ownerAadhaar    String?

  isSlum Boolean @default(false)
  remark String?

  parcelNo        String?
  propertyNo      String?
  electricityId   String?
  khasraNo        String?
  registryNo      String?
  constructedDate String?

  respondentName         String?
  respondentRelationship String?

  city       String?
  pincode    String?
  houseNo    String?
  streetName String?
  locality   String?
  colony     String?

  presentHouseNo    String?
  presentStreetName String?
  presentLocality   String?
  presentColony     String?
  presentCity       String?
  presentPincode    String?
  isSameAsProperty  Boolean?

  taxRateZone         String?
  propertyOwnership   String?
  propertyType        String?
  propertyUse         String?
  commercial          String?
  yearOfConstruction  String?
  exemptionType       String?
  exemptionApplicable Boolean?
  situation           String?
  roadType            String?

  floorsRaw String?

  plotAreaSqFt            Decimal? @db.Decimal(14, 4)
  plotAreaSqMeter         Decimal? @db.Decimal(14, 4)
  plinthAreaSqFt          Decimal? @db.Decimal(14, 4)
  plinthAreaSqMeter       Decimal? @db.Decimal(14, 4)
  totalBuiltUpAreaSqFt    Decimal? @db.Decimal(14, 4)
  totalBuiltUpAreaSqMeter Decimal? @db.Decimal(14, 4)

  hasMunicipalWaterSupply  Boolean?
  hasAlternateWater        Boolean?
  waterSourceType          String?
  totalWaterConnections    Int?
  waterConnectionIdType    String?
  toiletType               String?
  hasMunicipalWasteService Boolean?

  sourceExtras Json?
  importJobId  String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  createdBy   User?              @relation("SurveyCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?              @relation("SurveyUpdatedBy", fields: [updatedById], references: [id])
  floors      SurveyFloor[]
  attachments SurveyAttachment[]
  payments    Payment[]
  demands     AssessmentDemand[]

  @@index([wardId])
  @@index([mobile])
  @@index([ownerName])
  @@index([parcelNo])
  @@index([propertyNo])
  @@index([status])
  @@index([createdAt])
  @@index([surveyedAt])
  @@index([wardId, surveyedAt])
  @@index([wardId, parcelNo, propertyNo])
  @@index([dataQualityStatus])
  @@map("survey")
}

model SurveyFloor {
  id           String   @id @default(cuid())
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  floorLabel   String
  areaSqFt     Decimal? @db.Decimal(14, 4)
  areaSqMeter  Decimal? @db.Decimal(14, 4)
  usageType    String?
  usageFactor  String?
  buildingType String?
  sortOrder    Int      @default(0)
  rawSegment   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([surveyId])
  @@map("survey_floor")
}

model SurveyAttachment {
  id               String   @id @default(cuid())
  surveyId         String
  survey           Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  objectKey        String
  originalFileName String
  mimeType         String
  size             Int
  bucket           String
  uploadedById     String?
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime @default(now())

  @@index([surveyId])
  @@map("survey_attachment")
}

// ─── Import / Export ───────────────────────────────────────────

enum ImportJobStatus {
  UPLOADED
  VALIDATING
  READY
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

enum DuplicateStrategy {
  SKIP
  UPDATE
  CREATE
}

model ImportJob {
  id                String            @id @default(cuid())
  fileName          String
  fileSize          Int
  objectKey         String?
  status            ImportJobStatus   @default(UPLOADED)
  mappingPreset     String?
  columnMapping     Json?
  duplicateStrategy DuplicateStrategy @default(SKIP)
  totalRows         Int               @default(0)
  processedRows     Int               @default(0)
  successRows       Int               @default(0)
  failedRows        Int               @default(0)
  skippedRows       Int               @default(0)
  warningRows       Int               @default(0)
  insertedRows      Int               @default(0)
  updatedRows       Int               @default(0)
  errorFileKey      String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdById       String?
  createdBy         User?             @relation(fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  errors ImportError[]

  @@index([status])
  @@index([createdById])
  @@map("import_job")
}

model ImportError {
  id          String    @id @default(cuid())
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  rowNumber   Int
  surveyId    String?
  field       String?
  message     String
  severity    String    @default("error")
  rawRow      Json?
  createdAt   DateTime  @default(now())

  @@index([importJobId])
  @@map("import_error")
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ExportJob {
  id             String          @id @default(cuid())
  /// e.g. DEMAND_NOTICE_PDF; null/legacy for survey Excel exports
  jobType        String?
  filters        Json?
  status         ExportJobStatus @default(PENDING)
  fileKey        String?
  fileName       String?
  errorFileKey   String?
  rowCount       Int?
  processedCount Int?
  createdById    String?
  createdBy      User?           @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())
  completedAt    DateTime?
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([jobType, status])
  @@map("export_job")
}

// ─── Reference catalogs & tax configuration ────────────────────

enum ReferenceEntryStatus {
  ACTIVE
  INACTIVE
}

enum TaxConfigStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ReferenceCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  iconKey     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries ReferenceEntry[]

  @@map("reference_category")
}

model ReferenceEntry {
  id          String               @id @default(cuid())
  categoryId  String
  category    ReferenceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String?
  value       String?
  sortOrder   Int                  @default(0)
  status      ReferenceEntryStatus @default(ACTIVE)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  taxConfigsAssessmentYear TaxConfig[]            @relation("TaxConfigAssessmentYear")
  paymentsAssessmentYear   Payment[]              @relation("PaymentAssessmentYear")
  demandsAssessmentYear    AssessmentDemand[]     @relation("DemandAssessmentYear")
  taxCellsRoad             TaxRateCell[]          @relation("CellRoadWidth")
  taxCellsConstruction     TaxRateCell[]          @relation("CellConstruction")
  yearProfile              AssessmentYearProfile?
  rebatePolicies           RebatePolicy[]         @relation("RebatePolicyYear")
  penaltyPolicies          PenaltyPolicy[]        @relation("PenaltyPolicyYear")

  @@unique([categoryId, code])
  @@index([categoryId, status])
  @@map("reference_entry")
}

model TaxConfig {
  id                      String          @id @default(cuid())
  wardId                  String
  ward                    Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  assessmentYearId        String
  assessmentYear          ReferenceEntry  @relation("TaxConfigAssessmentYear", fields: [assessmentYearId], references: [id])
  status                  TaxConfigStatus @default(DRAFT)
  version                 Int             @default(1)
  effectiveFrom           DateTime?
  propertyTaxPct          Decimal         @default(10) @db.Decimal(8, 4)
  waterTaxPct             Decimal         @default(7.5) @db.Decimal(8, 4)
  drainageTaxPct          Decimal         @default(2.5) @db.Decimal(8, 4)
  penaltyPct              Decimal         @default(0) @db.Decimal(8, 4)
  assessablePct           Decimal         @default(80) @db.Decimal(8, 4)
  commercialAssessablePct Decimal         @default(80) @db.Decimal(8, 4)
  publishedAt             DateTime?
  publishedById           String?
  changeReason            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  cells    TaxRateCell[]
  versions TaxConfigVersion[]
  demands  AssessmentDemand[]

  @@unique([wardId, assessmentYearId])
  @@index([wardId, assessmentYearId])
  @@index([status])
  @@map("tax_config")
}

model TaxRateCell {
  id                  String         @id @default(cuid())
  taxConfigId         String
  taxConfig           TaxConfig      @relation(fields: [taxConfigId], references: [id], onDelete: Cascade)
  roadWidthEntryId    String
  roadWidthEntry      ReferenceEntry @relation("CellRoadWidth", fields: [roadWidthEntryId], references: [id])
  constructionEntryId String
  constructionEntry   ReferenceEntry @relation("CellConstruction", fields: [constructionEntryId], references: [id])
  annualRatePerSqFt   Decimal        @default(0) @db.Decimal(14, 4)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([taxConfigId, roadWidthEntryId, constructionEntryId])
  @@map("tax_rate_cell")
}

model TaxConfigVersion {
  id          String    @id @default(cuid())
  taxConfigId String
  taxConfig   TaxConfig @relation(fields: [taxConfigId], references: [id], onDelete: Cascade)
  version     Int
  snapshot    Json
  reason      String?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([taxConfigId, version])
  @@map("tax_config_version")
}

// ─── Payments ──────────────────────────────────────────────────

enum PaymentMode {
  ONLINE
  CASH
  CHEQUE
  DD
  UPI_MANUAL
  OTHER
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String          @id @default(cuid())
  paymentReference  String          @unique
  merchTxnId        String?         @unique
  atomTxnId         String?         @unique
  surveyId          String?
  survey            Survey?         @relation(fields: [surveyId], references: [id])
  wardId            String?
  ward              Ward?           @relation(fields: [wardId], references: [id])
  assessmentYearId  String?
  assessmentYear    ReferenceEntry? @relation("PaymentAssessmentYear", fields: [assessmentYearId], references: [id])
  payerName         String?
  payerMobile       String?
  payerEmail        String?
  amount            Decimal         @db.Decimal(14, 2)
  currency          String          @default("INR")
  paymentMode       PaymentMode
  status            PaymentStatus   @default(INITIATED)
  gateway           String?
  gatewayReference  String?
  receiptNumber     String?         @unique
  collectionDate    DateTime?
  chequeDdReference String?
  remarks           String?
  collectedById     String?
  collectedBy       User?           @relation("PaymentCollectedBy", fields: [collectedById], references: [id])
  counterCode       String?
  idempotencyKey    String?         @unique
  receiptSnapshot   Json?
  attachmentKey     String?
  refundableAmount  Decimal?        @db.Decimal(14, 2)
  /// Set when a successful payment is reversed. The receipt is kept and stamped.
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  transactions PaymentTransaction[]
  callbacks    PaymentCallback[]
  refunds      PaymentRefund[]
  allocations  PaymentAllocation[]

  @@index([status])
  @@index([createdAt])
  @@index([surveyId])
  @@index([wardId])
  @@index([paymentMode])
  @@index([surveyId, status, assessmentYearId])
  @@index([collectionDate])
  @@map("payment")
}

/// Per-assessment-year counter for offline receipt numbers. Incremented inside the collection transaction.
model ReceiptSequence {
  yearCode  String @id
  lastValue Int    @default(0)

  @@map("receipt_sequence")
}

model PaymentTransaction {
  id              String   @id @default(cuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id])
  direction       String
  requestPayload  Json?
  responsePayload Json?
  statusCode      String?
  message         String?
  createdAt       DateTime @default(now())

  @@index([paymentId])
  @@map("payment_transaction")
}

model PaymentCallback {
  id             String   @id @default(cuid())
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])
  merchTxnId     String?
  atomTxnId      String?
  statusCode     String?
  rawPayload     Json
  processed      Boolean  @default(false)
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  @@index([merchTxnId])
  @@index([atomTxnId])
  @@map("payment_callback")
}

enum RefundStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

model PaymentRefund {
  id              String       @id @default(cuid())
  paymentId       String
  payment         Payment      @relation(fields: [paymentId], references: [id])
  refundReference String       @unique
  amount          Decimal      @db.Decimal(14, 2)
  status          RefundStatus @default(INITIATED)
  gatewayRefundId String?
  reason          String?
  rawResponse     Json?
  createdById     String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([paymentId])
  @@index([status])
  @@map("payment_refund")
}

model PaymentSettlement {
  id             String    @id @default(cuid())
  settlementDate DateTime?
  merchTxnId     String?
  atomTxnId      String?
  amount         Decimal?  @db.Decimal(14, 2)
  status         String?
  settlementUtr  String?
  rawPayload     Json?
  createdAt      DateTime  @default(now())

  @@index([merchTxnId])
  @@index([settlementDate])
  @@map("payment_settlement")
}

// ─── Assessment-year demand ledger ─────────────────────────────

enum AssessmentDemandStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum AssessmentDemandSource {
  CALCULATED
  OPENING_BALANCE
}

enum PaymentAllocationStatus {
  ACTIVE
  REVERSED
}

enum DemandAdjustmentKind {
  CREDIT
  DEBIT
}

enum AssessmentYearLifecycle {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum RebateType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PenaltyType {
  PERCENT_OF_PROPERTY_TAX
  PERCENT_OF_ELIGIBLE_BASE
  FIXED_AMOUNT
}

/// Which tax a rebate or penalty rule applies to. COMBINED is the legacy
/// single rule whose include* flags choose the components; category rules
/// apply only to their own component (and its own arrears when allowed).
enum TaxCategory {
  COMBINED
  PROPERTY_TAX
  WATER_TAX
  DRAINAGE_TAX
}

enum PenaltyTrigger {
  ON_ASSESSMENT
  DUE_DATE_PASSED
}

enum DemandVerificationStatus {
  UNVERIFIED
  VERIFIED
}

enum DemandBalanceKind {
  COMPONENTS
  CLOSING_ONLY
}

/// Dates and lifecycle for an assessment-year catalog row. One database is one municipality.
model AssessmentYearProfile {
  id               String                  @id @default(cuid())
  referenceEntryId String                  @unique
  referenceEntry   ReferenceEntry          @relation(fields: [referenceEntryId], references: [id])
  startsOn         DateTime                @db.Date
  endsOn           DateTime                @db.Date
  status           AssessmentYearLifecycle @default(DRAFT)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status])
  @@map("assessment_year_profile")
}

model RebatePolicy {
  id                 String         @id @default(cuid())
  name               String
  assessmentYearId   String
  assessmentYear     ReferenceEntry @relation("RebatePolicyYear", fields: [assessmentYearId], references: [id])
  taxCategory        TaxCategory    @default(COMBINED)
  rebateType         RebateType
  rate               Decimal?       @db.Decimal(8, 4)
  fixedAmount        Decimal?       @db.Decimal(14, 2)
  includePropertyTax Boolean        @default(true)
  includeWaterTax    Boolean        @default(true)
  includeDrainageTax Boolean        @default(true)
  includeArrears     Boolean        @default(true)
  includePenalty     Boolean        @default(false)
  includeInterest    Boolean        @default(false)
  maxAmount          Decimal?       @db.Decimal(14, 2)
  startsOn           DateTime?      @db.Date
  endsOn             DateTime?      @db.Date
  paymentDeadline    DateTime?      @db.Date
  status             PolicyStatus   @default(DRAFT)
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?          @relation("RebatePolicyApprovedBy", fields: [approvedById], references: [id])
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  demands AssessmentDemand[]

  @@index([assessmentYearId, status])
  @@index([assessmentYearId, taxCategory, status])
  @@map("rebate_policy")
}

model PenaltyPolicy {
  id                 String         @id @default(cuid())
  name               String
  assessmentYearId   String
  assessmentYear     ReferenceEntry @relation("PenaltyPolicyYear", fields: [assessmentYearId], references: [id])
  taxCategory        TaxCategory    @default(COMBINED)
  penaltyType        PenaltyType
  rate               Decimal?       @db.Decimal(8, 4)
  fixedAmount        Decimal?       @db.Decimal(14, 2)
  trigger            PenaltyTrigger @default(ON_ASSESSMENT)
  graceDays          Int            @default(0)
  dueDate            DateTime?      @db.Date
  includePropertyTax Boolean        @default(true)
  includeWaterTax    Boolean        @default(false)
  includeDrainageTax Boolean        @default(false)
  includeArrears     Boolean        @default(false)
  /// When true, percentage penalty is calculated on the eligible base after rebate.
  applyAfterRebate   Boolean        @default(false)
  maxAmount          Decimal?       @db.Decimal(14, 2)
  startsOn           DateTime?      @db.Date
  endsOn             DateTime?      @db.Date
  status             PolicyStatus   @default(DRAFT)
  approvedAt         DateTime?
  approvedById       String?
  approvedBy         User?          @relation("PenaltyPolicyApprovedBy", fields: [approvedById], references: [id])
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  demands AssessmentDemand[]

  @@index([assessmentYearId, status])
  @@index([assessmentYearId, taxCategory, status])
  @@map("penalty_policy")
}

/// One published row per property and assessment year is enforced by
/// partial unique index assessment_demand_one_published (see migration SQL).
model AssessmentDemand {
  id                 String                   @id @default(cuid())
  surveyId           String
  survey             Survey                   @relation(fields: [surveyId], references: [id])
  wardId             String
  ward               Ward                     @relation(fields: [wardId], references: [id])
  assessmentYearId   String
  assessmentYear     ReferenceEntry           @relation("DemandAssessmentYear", fields: [assessmentYearId], references: [id])
  taxConfigId        String?
  taxConfig          TaxConfig?               @relation(fields: [taxConfigId], references: [id])
  taxConfigVersion   Int?
  demandReference    String                   @unique
  status             AssessmentDemandStatus   @default(PUBLISHED)
  source             AssessmentDemandSource
  propertyTax        Decimal                  @db.Decimal(14, 2)
  waterTax           Decimal                  @db.Decimal(14, 2)
  drainageTax        Decimal                  @db.Decimal(14, 2)
  penalty            Decimal                  @default(0) @db.Decimal(14, 2)
  interest           Decimal                  @default(0) @db.Decimal(14, 2)
  currentYearDemand  Decimal                  @db.Decimal(14, 2)
  openingArrears     Decimal                  @default(0) @db.Decimal(14, 2)
  rebateAmount       Decimal                  @default(0) @db.Decimal(14, 2)
  historicalPayments Decimal                  @default(0) @db.Decimal(14, 2)
  rebatePolicyId     String?
  rebatePolicy       RebatePolicy?            @relation(fields: [rebatePolicyId], references: [id])
  penaltyPolicyId    String?
  penaltyPolicy      PenaltyPolicy?           @relation(fields: [penaltyPolicyId], references: [id])
  verificationStatus DemandVerificationStatus @default(VERIFIED)
  verifiedById       String?
  verifiedBy         User?                    @relation("DemandVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  sourceReference    String?
  remarks            String?
  balanceKind        DemandBalanceKind        @default(COMPONENTS)
  /// Per-category rebate/penalty amounts and rule IDs used when published.
  chargeBreakdown    Json?
  idempotencyKey     String?                  @unique
  publishedAt        DateTime?
  publishedById      String?
  publishedBy        User?                    @relation("DemandPublishedBy", fields: [publishedById], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  allocations  PaymentAllocation[]
  adjustments  DemandAdjustment[]
  noticeIssues DemandNoticeIssue[]

  @@index([surveyId, status])
  @@index([surveyId, assessmentYearId, status])
  @@index([wardId, assessmentYearId])
  @@map("assessment_demand")
}

model DemandNoticeIssue {
  id                 String           @id @default(cuid())
  assessmentDemandId String
  assessmentDemand   AssessmentDemand @relation(fields: [assessmentDemandId], references: [id])
  version            Int
  fileKey            String?
  generatedAt        DateTime         @default(now())
  generatedById      String?
  generatedBy        User?            @relation("NoticeGeneratedBy", fields: [generatedById], references: [id])

  @@unique([assessmentDemandId, version])
  @@index([assessmentDemandId])
  @@map("demand_notice_issue")
}

model PaymentAllocation {
  id                 String                  @id @default(cuid())
  paymentId          String
  payment            Payment                 @relation(fields: [paymentId], references: [id])
  assessmentDemandId String
  assessmentDemand   AssessmentDemand        @relation(fields: [assessmentDemandId], references: [id])
  amount             Decimal                 @db.Decimal(14, 2)
  status             PaymentAllocationStatus @default(ACTIVE)
  createdById        String?
  createdBy          User?                   @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime                @default(now())
  reversedAt         DateTime?

  @@unique([paymentId, assessmentDemandId])
  @@index([assessmentDemandId, status])
  @@index([paymentId, status])
  @@map("payment_allocation")
}

model DemandAdjustment {
  id                   String               @id @default(cuid())
  assessmentDemandId   String
  assessmentDemand     AssessmentDemand     @relation(fields: [assessmentDemandId], references: [id])
  kind                 DemandAdjustmentKind
  amount               Decimal              @db.Decimal(14, 2)
  reason               String
  createdById          String?
  createdBy            User?                @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  reversesAdjustmentId String?
  reversesAdjustment   DemandAdjustment?    @relation("AdjustmentReversal", fields: [reversesAdjustmentId], references: [id])
  reversedBy           DemandAdjustment[]   @relation("AdjustmentReversal")
  createdAt            DateTime             @default(now())

  @@index([assessmentDemandId])
  @@map("demand_adjustment")
}

// ─── Audit ─────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  ipAddress String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
