PORT=4000
NODE_ENV=development
# Optional email domain used for gateway checkout when a citizen does not enter an email.
PUBLIC_CITIZEN_EMAIL_DOMAIN=citizen.local
# Optional JSON override for the municipality's database-backed ward list.
# Replace sample locality names before seeding another Nagar Panchayat.
# MUNICIPALITY_WARDS_JSON=[{"number":1,"code":"W01","name":"Ward 01 - Sample Locality"},{"number":2,"code":"W02","name":"Ward 02 - Market Area"},{"number":3,"code":"W03","name":"Ward 03 - Station Road"},{"number":4,"code":"W04","name":"Ward 04 - Model Colony"},{"number":5,"code":"W05","name":"Ward 05 - Main Bazaar"},{"number":6,"code":"W06","name":"Ward 06 - River Side"},{"number":7,"code":"W07","name":"Ward 07 - Green Park"},{"number":8,"code":"W08","name":"Ward 08 - Gandhi Nagar"},{"number":9,"code":"W09","name":"Ward 09 - Shanti Vihar"},{"number":10,"code":"W10","name":"Ward 10 - Old Town"},{"number":11,"code":"W11","name":"Ward 11 - New Colony"},{"number":12,"code":"W12","name":"Ward 12 - Industrial Area"},{"number":13,"code":"W13","name":"Ward 13 - Patel Nagar"},{"number":14,"code":"W14","name":"Ward 14 - Nehru Nagar"},{"number":15,"code":"W15","name":"Ward 15 - Ambedkar Nagar"},{"number":16,"code":"W16","name":"Ward 16 - Housing Board"},{"number":17,"code":"W17","name":"Ward 17 - University Road"},{"number":18,"code":"W18","name":"Ward 18 - Extension Area"}]
DATABASE_URL=postgresql://nppdhanaura:nppdhanaura@localhost:5433/nppdhanaura?schema=public
REDIS_URL=redis://localhost:6380
STORAGE_DIR=uploads
# Optional: Property Tax Demand Notice PDF (Playwright).
# Local: pnpm --filter api playwright:install
# Docker sets CHROMIUM / logo paths automatically.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# DEMAND_NOTICE_LOGO_PATH=/app/assets/up-government-logo.png
# Comma-separated trusted origins (portal + citizen web). Production example:
# CORS_ORIGIN=https://portal.npchhata.com,https://npchhata.com
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Must be the public portal origin (session cookies + portal /api BFF).
PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Session cookie + lifetime (defaults shown).
SESSION_COOKIE_NAME=nppdhanaura_session
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=604800
# Argon2id password hashing (defaults shown).
ARGON2_MEMORY_KB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# CSRF double-submit cookie for authenticated mutating requests.
CSRF_COOKIE_NAME=csrf_token
# Legacy alias during migration (optional, development only):
# BETTER_AUTH_SECRET=
# Seed admin (used by prisma seed / API startup). Never commit real passwords.
# Production requires SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD (SUPER_ADMIN_* aliases also work).
SEED_ADMIN_EMAIL=sikarwar2010@gmail.com
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_PASSWORD=tarun@0446

# --- Payments (Atom AIPay — card / UPI / netbanking widget) ---
# sandbox = local fake redirect (no card/UPI UI)
# atom = live Atom AIPay auth + atomcheckout.js (shows card, UPI, NB)
PAYMENT_PROVIDER=sandbox
ATOM_BASE_URL=https://paynetzuat.atomtech.in
# AIPay auth (UAT Payment Url). Prod often uses https://payment1.atomtech.in/ots/aipay/auth
ATOM_AUTH_URL=https://paynetzuat.atomtech.in/ots/aipay/auth
# Checkout CDN (UAT). Prod: https://psa.atomtech.in/staticdata/ots/js/atomcheckout.js
ATOM_CHECKOUT_CDN=https://pgtest.atomtech.in/staticdata/ots/js/atomcheckout.js
# Second arg to AtomPaynetz: uat | prod
ATOM_CHECKOUT_ENV=uat
# Citizen web page after pay (apps/web). API 302s here from gateway/return.
ATOM_RETURN_URL=http://localhost:3001/propertytax/payment/return
# Server-to-server callback (Atom POST, often form-urlencoded encData).
ATOM_CALLBACK_URL=http://localhost:4000/api/v1/payments/gateway/callback
# Browser return Atom posts to (decrypt + 302 to ATOM_RETURN_URL). Optional;
# defaults to ATOM_CALLBACK_URL with /callback → /return.
# ATOM_GATEWAY_RETURN_URL=http://localhost:4000/api/v1/payments/gateway/return
#
# UAT field → env (never commit real secrets; use apps/api/.env):
#   Merch ID / User ID     → ATOM_MERCH_ID
#   Transaction Password   → ATOM_PASSWORD
#   Secret Key             → ATOM_API_SECRET_KEY  (used for OTS status/refund Bearer)
#   Product ID (NSE/BSE)   → ATOM_PRODUCT
#   AES Request Key        → ATOM_AES_REQUEST_KEY
#   AES Request Salt/IV    → ATOM_AES_REQUEST_IV   (PBKDF2 salt; often same as key)
#   AES Response Key       → ATOM_AES_RESPONSE_KEY
#   AES Response Salt/IV   → ATOM_AES_RESPONSE_IV
# Optional. When ATOM_RESP_HASH_KEY is set, Atom callbacks must pass HMAC-SHA512.
ATOM_REQ_HASH_KEY=
ATOM_RESP_HASH_KEY=
ATOM_MERCH_ID=
ATOM_PASSWORD=
ATOM_API_SECRET_KEY=
ATOM_AES_REQUEST_KEY=
ATOM_AES_REQUEST_IV=
ATOM_AES_RESPONSE_KEY=
ATOM_AES_RESPONSE_IV=
ATOM_PRODUCT=NSE
IMPORT_MAX_FILE_SIZE_MB=50
# Municipal ULB code embedded in GIS Survey Id (default: 249044 for Chhata)
ULB_CODE=249044

# NestJS Observe APM (optional). When both are set, telemetry is sent to Observe.
# Sign up at https://observe.nestjs.com and create a service for keys.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
