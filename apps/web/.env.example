# Citizen web dev server runs on port 3001.
# Leave NEXT_PUBLIC_API_URL empty so the browser uses same-origin /api rewrites (recommended).
# NEXT_PUBLIC_API_URL=
#
# Server-side rewrite target (Next → Nest). Prefer 127.0.0.1 on Windows
# (Nest listens on IPv4 0.0.0.0; localhost may resolve to ::1).
# In Docker production this is http://goverdhan-api:4000 (set by compose/Dockerfile).
API_INTERNAL_URL=http://127.0.0.1:4000
#
# Property-tax portal identity. Ward names are returned from the API database.
NEXT_PUBLIC_MUNICIPALITY_NAME=Nagar Panchayat Goverdhan
NEXT_PUBLIC_MUNICIPALITY_CITY=Mathura
NEXT_PUBLIC_MUNICIPALITY_STATE=Uttar Pradesh
# Optional public URL or path to the municipality emblem.
# NEXT_PUBLIC_MUNICIPALITY_LOGO_URL=/images/municipality-logo.png
#
# Payment return URL is configured on the API (ATOM_RETURN_URL), not here:
#   http://localhost:3001/propertytax/payment/return
